# -c with a command does not read stdin
stdin stdin.sh
exec gosh -c 'echo from-c'
stdout 'from-c'
! stdout 'from-stdin'

# an empty -c is a no-op, like in other shells
# TODO: stdin should not be run
stdin stdin.sh
exec gosh -c ''
stdout 'from-stdin'

# without -c, stdin is run
stdin stdin.sh
exec gosh
stdout 'from-stdin'

-- stdin.sh --
echo from-stdin
